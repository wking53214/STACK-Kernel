{
  "schema": "cns-digest-vectors/2",
  "digest_version": "cns-digest/1",
  "note": "digest is cns.gate.subject_digest(content) and rendering is the string it hashes; restricted_v1 is computed by cns_composition.digest_vectors.restricted_v1; regenerate with python -m cns_composition.digest_vectors --write",
  "domain": {
    "content": "A map whose keys are text. This is what a verdict binds to and what every vector holds.",
    "values": [
      "null",
      "boolean (distinct from the integers 0 and 1)",
      "integer of any magnitude (a JSON number with no fraction and no exponent)",
      "float: a finite IEEE 754 binary64 value (a JSON number with a fraction or an exponent); -0.0 renders as 0.0; NaN and the infinities are refused",
      "text: a sequence of Unicode scalar values; a lone surrogate is refused",
      "list of values",
      "map from text keys to values; keys are distinct"
    ],
    "rendering": {
      "null": "n:",
      "boolean": "b:1 for true, b:0 for false",
      "integer": "i:<base 10, a leading - when negative, no leading zeros>:",
      "float": "f:<Python repr of the binary64 value, shortest round trip>:",
      "text": "s:<number of code points, base 10>:<the text>",
      "list": "l:<number of items>:<each item rendered, in order>",
      "map": "d:<number of members>:<for each key in ascending code point order: the key rendered as text, then its value rendered>"
    },
    "digest": "SHA-256 of the UTF-8 bytes of the rendering, written as 64 lowercase hex characters",
    "depth": "The normative domain sets no nesting limit. Container depth is 0 for a scalar and 1 plus the deepest member for a map or list, so a content map of scalars has depth 1. The Python reference raises RecursionError, not TypeError, at roughly 500 levels.",
    "restricted_v1": {
      "who": "STACK-Kernel stack-trident, envelope subject_digest, at its default limits (max_depth 32)",
      "rule": "No float anywhere. Every integer within -(2^53 - 1) to 2^53 - 1 inclusive. Container depth of the content (counted as in `depth`) at most 31. Everything else as in the normative domain.",
      "why_31": "The Trident counts the envelope object as nesting level 1, so the payload's top-level map is level 2 and a payload may nest max_depth - 1 = 31 levels. Calling stack_trident::cns_digest::subject_digest directly accepts depth up to max_depth (32); the envelope path (seal and verify) refuses depth 32 with TooDeep before the digest is computed.",
      "max_container_depth": 31,
      "max_abs_integer": 9007199254740991,
      "outside": "The Trident refuses content outside restricted_v1 with a typed error. It never computes a different digest and never falls back to another canonicalization.",
      "not_part_of_the_domain": "Envelope size (65,536 canonical JSON bytes) and value-count (16,384) caps are transport limits of a deployment, not of the digest. Every vector here is within them."
    }
  },
